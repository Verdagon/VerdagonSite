<span style="color: #c9d1d9">                    </span><span style="color: #8b949e">#</span><span style="color: #8b949e"> We reached where we last saw them. Give up.</span>
<span style="color: #c9d1d9">                    </span><span style="color: #c9d1d9">entity</span><span style="color: #c9d1d9">.</span><span style="color: #c9d1d9">directive</span><span style="color: #c9d1d9"> </span><span style="color: #ff7b72">=</span><span style="color: #c9d1d9"> </span><span style="color: #d2a8ff">LoiterDirective</span><span style="color: #c9d1d9">(</span><span style="color: #c9d1d9">)</span>
<span style="color: #c9d1d9">                </span><span style="color: #ff7b72">else</span><span style="color: #c9d1d9">:</span>
<span style="color: #c9d1d9">                    </span><span style="color: #ff7b72">pass</span><span style="color: #c9d1d9"> </span><span style="color: #8b949e">#</span><span style="color: #8b949e"> Keep pursuing!</span>
<span style="color: #c9d1d9">    </span><span style="color: #c9d1d9">...</span>
