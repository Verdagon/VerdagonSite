    var bird = Bird(Wing(10), Wing(20), Tail(15))
    ref tail_ref = bird.tail
    evolve(bird, tail_ref, tail_ref)

fn evolve(
    bird: Bird,
    mut [bird.tail] tail_a: Tail,
    mut [bird.tail] tail_b: Tail
):
    tail_b.length += bird.get_weight() + tail_a.length
```
