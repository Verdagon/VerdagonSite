<span style="color: #c9d1d9">            </span><span style="color: #ff7b72">else</span><span style="color: #c9d1d9">:</span><span style="color: #c9d1d9"> </span><span style="color: #8b949e">#</span><span style="color: #8b949e"> Can&#039;t see the player.</span>
